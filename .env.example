# MySQL Source Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# PostgreSQL Target Database (Phase 4)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DATABASE=your_pg_database
PG_SSL=false

# Server-managed Scheduler (starts with the persistent Next.js Node server)
SCHEDULER_TIMEZONE=Asia/Kuala_Lumpur
SCHEDULER_POLL_INTERVAL_MS=15000
# Set true only if an external scheduler exclusively owns all triggers.
DISABLE_INTERNAL_SCHEDULER=false
# Keep local development safe; opt in only when testing real scheduled runs.
ENABLE_INTERNAL_SCHEDULER_IN_DEV=false

# Optional external scheduler/CLI fallback
# Generate with: openssl rand -hex 32
SCHEDULER_API_TOKEN=replace_with_a_random_64_character_secret
RUN_TIMEOUT_SECONDS=86400
SCHEDULE_TRIGGER_RETRY_SECONDS=900
SCHEDULE_TRIGGER_RETRY_INTERVAL_SECONDS=15
SCHEDULE_TRIGGER_REQUEST_TIMEOUT_SECONDS=15
SCHEDULE_AUTO_RESUME_ATTEMPTS=3
